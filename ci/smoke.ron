// Native headless smoke test (bevy_ci_testing, see scripts/smoke-native.sh).
// Schema: bevy_dev_tools 0.19 CiTestingConfig.
// The game boots to the title; Custom("play") starts level one (menu module).
(
    setup: (
        fixed_frame_time: Some(0.016666668),
    ),
    events: [
        (40, NamedScreenshot("title")),
        (50, Custom("play")),
        (110, NamedScreenshot("smoke")),
        (130, AppExit),
    ],
)
